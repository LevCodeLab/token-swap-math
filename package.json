{
  "name": "token-swap-math",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript library for constant-product (x * y = k) AMM swaps, sequential multi-order price impact, exact exit quotes, PnL accounting, and liquidation ladders.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "amm",
    "constant-product",
    "bonding-curve",
    "swap-math",
    "price-impact",
    "pnl",
    "defi",
    "typescript"
  ],
  "author": "LevCodeLab",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
